{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI GameDev CURRENT_STATUS v2",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "repository",
    "default_branch",
    "observed_main_head",
    "state",
    "active_lane_state",
    "next_slice"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "updated_at": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "default_branch": {
      "type": "string"
    },
    "observed_main_head": {
      "type": [
        "string",
        "null"
      ],
      "description": "Last-observed main/default-branch head snapshot; live Git state is authoritative."
    },
    "state": {
      "enum": [
        "IDLE",
        "IN_PROGRESS",
        "VERIFIED_NOT_MERGED",
        "MERGED",
        "BLOCKED",
        "RELEASE_PENDING"
      ]
    },
    "active_lane_state": {
      "enum": [
        "KNOWN",
        "NONE",
        "AMBIGUOUS"
      ]
    },
    "active_lane": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_work": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocking_gate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "active_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "pr": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_head": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "OPEN",
          "PENDING",
          "READY_NOT_EXECUTED",
          "SKIPPED",
          "INFRA_FAILURE",
          "UNKNOWN"
        ]
      }
    },
    "next_slice": {
      "type": "object",
      "required": [
        "id",
        "goal"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "risk": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "deferred_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_debts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "active_lane_state": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "required": [
          "active_work"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "active_lane_state": {
            "const": "AMBIGUOUS"
          }
        }
      },
      "then": {
        "required": [
          "active_candidates"
        ],
        "properties": {
          "active_candidates": {
            "minItems": 2
          }
        }
      }
    }
  ],
  "additionalProperties": false
}